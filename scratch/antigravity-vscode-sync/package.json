{
  "name": "antigravity-vscode-sync",
  "displayName": "Antigravity Cloud Sync",
  "description": "Synchronize Antigravity memory and skills via private Git repository",
  "version": "1.5.1",
  "publisher": "mimilouze",
  "repository": {
    "type": "git",
    "url": "https://github.com/mimilouze/antigravity-vscode-sync.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:antigravity-sync-hub"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-sync-sidebar",
          "title": "Antigravity Sync",
          "icon": "$(cloud)"
        }
      ]
    },
    "views": {
      "antigravity-sync-sidebar": [
        {
          "id": "antigravity-sync-hub",
          "type": "webview",
          "name": "Sync Hub",
          "icon": "$(sync)"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity.syncMenu",
        "title": "Antigravity: Sync Menu"
      },
      {
        "command": "antigravity.syncConfig",
        "title": "Antigravity: Configure Cloud Sync"
      },
      {
        "command": "antigravity.openSyncHub",
        "title": "Antigravity: Open Sync Hub"
      }
    ],
    "configuration": {
      "title": "Antigravity Sync",
      "properties": {
        "antigravity.autoSync": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic synchronization (Push) when changes are detected."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
